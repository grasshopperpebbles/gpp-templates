# Auth flows (gpp add auth-flows): email verification and password reset
# EMAIL_PROVIDER: console | resend | sendgrid | ses. Unset: "console" in development
# (ENVIRONMENT=development, or DEBUG=true), which logs each email with its link
# instead of sending it; elsewhere the provider chosen at install time ({{EMAIL_PROVIDER}}).
# EMAIL_PROVIDER={{EMAIL_PROVIDER}}
EMAIL_FROM=noreply@example.com
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# ses: boto3 reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (or an IAM role)
# AWS_REGION=us-east-1
# Web app base URL for the links in the emails (/verify-email, /reset-password)
APP_URL=http://localhost:3000
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=60
