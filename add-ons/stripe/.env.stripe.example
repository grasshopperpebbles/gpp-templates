# Stripe env, by app. `gpp add stripe` writes each app's block into that app's .env.example.
# Secret keys (sk_..., whsec_...) belong only to server-side apps: the API and web server routes.
# Desktop and mobile apps ship to users, so they get a publishable key or nothing.

# --- API app (creates Checkout Sessions: POST /api/v1/stripe/checkout-session) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_IDS=price_...
STRIPE_CHECKOUT_MODE=payment
STRIPE_CHECKOUT_SUCCESS_URL=https://example.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://example.com/checkout/cancel
STRIPE_CHECKOUT_ALLOWED_ORIGINS=

# --- Web app (Next.js): STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET as above, server routes only ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Mobile (Expo): publishable key only ---
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Desktop: Tauri gets the publishable key only; Electron gets no Stripe key at all ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
