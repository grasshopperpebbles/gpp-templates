// Example configuration for cloud storage providers
// Add to config/plugins.ts when enabling upload providers

// AWS S3 Provider Configuration
// Uncomment and configure when using AWS S3 for media storage
/*
upload: {
  config: {
    provider: 'aws-s3',
    providerOptions: {
      accessKeyId: env('AWS_ACCESS_KEY_ID'),
      secretAccessKey: env('AWS_SECRET_ACCESS_KEY'),
      region: env('AWS_REGION', 'us-east-1'),
      params: {
        Bucket: env('AWS_S3_BUCKET'),
      },
    },
    actionOptions: {
      upload: {},
      uploadStream: {},
      delete: {},
    },
  },
},
*/

// Cloudinary Provider Configuration
// Uncomment and configure when using Cloudinary for media storage
/*
upload: {
  config: {
    provider: 'cloudinary',
    providerOptions: {
      cloud_name: env('CLOUDINARY_NAME'),
      api_key: env('CLOUDINARY_KEY'),
      api_secret: env('CLOUDINARY_SECRET'),
    },
    actionOptions: {
      upload: {},
      uploadStream: {},
      delete: {},
    },
  },
},
*/

