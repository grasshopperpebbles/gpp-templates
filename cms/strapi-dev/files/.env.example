#===============================================================================
# STRAPI DEVELOPMENT - ENVIRONMENT VARIABLES
#===============================================================================
# gpp writes .env from this file when the project is created, with a fresh
# random secret for each Strapi secret below.
#===============================================================================

# Database Configuration
# For Docker Compose: DATABASE_HOST=db (service name)
# For local MySQL: DATABASE_HOST=localhost
DATABASE_HOST=localhost
DATABASE_PORT=3308
DATABASE_NAME=strapi_dev
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# MySQL Configuration (for Docker Compose)
MYSQL_DATABASE=strapi_dev
MYSQL_USER=strapi
MYSQL_PASSWORD=strapi
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3308

# Strapi Secrets (replaced with random values by gpp at scaffold time)
# These are required for Strapi to start
APP_KEYS=gpp:generate-secret
STRAPI_APP_KEY=gpp:generate-secret
STRAPI_API_TOKEN_SALT=gpp:generate-secret
STRAPI_ADMIN_JWT_SECRET=gpp:generate-secret
STRAPI_TRANSFER_TOKEN_SALT=gpp:generate-secret
STRAPI_JWT_SECRET=gpp:generate-secret

# Server Configuration
HOST=0.0.0.0
PORT=1337
STRAPI_URL=http://localhost:1338
STRAPI_PORT=1338

# Admin Configuration
ADMIN_URL=/admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3004

# Project Configuration
# Lowercase slug for Docker project name and container_name (set by `gpp recipe apply` as {{PROJECT_SLUG}}). Do not use tutorial placeholders like my-store.
PROJECT_SLUG={{PROJECT_SLUG}}
SITE_NAME=Strapi Development
TIMEZONE=America/New_York

# phpMyAdmin Port (for Docker Compose)
PHPMYADMIN_PORT=9092
