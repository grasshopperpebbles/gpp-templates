#===============================================================================
# STRAPI DEVELOPMENT - ENVIRONMENT VARIABLES
#===============================================================================
# Copy this file to .env in the strapi-dev directory
# Run: gpp env sync (from project root) to create .env from this template
#===============================================================================

# Database Configuration
# For Docker Compose: DATABASE_HOST=db (service name)
# For local MySQL: DATABASE_HOST=localhost
DATABASE_HOST=localhost
DATABASE_PORT=3308
DATABASE_NAME=strapi_dev
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# MySQL Configuration (for Docker Compose)
MYSQL_DATABASE=strapi_dev
MYSQL_USER=strapi
MYSQL_PASSWORD=strapi
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3308

# Strapi Secrets (generate with: openssl rand -base64 32)
# These are required for Strapi to start
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
APP_KEYS=
JWT_SECRET=
STRAPI_APP_KEY=
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_JWT_SECRET=

# Server Configuration
HOST=0.0.0.0
PORT=1337
STRAPI_URL=http://localhost:1337

# Admin Configuration
ADMIN_URL=/admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Project Configuration
PROJECT_SLUG=strapi-dev
SITE_NAME=Strapi Development
TIMEZONE=America/New_York

# phpMyAdmin Port (for Docker Compose)
PHPMYADMIN_PORT=9092
