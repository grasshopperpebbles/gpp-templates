// Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // MySQL (GPP's root docker-compose runs mysql:8.4 as <api-folder>-mysql)
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// "admin" may list/read/create users and change or delete other accounts (see README).
enum Role {
  user
  admin
}

// User model - basic authentication and profile
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  password      String?
  role          Role           @default(user)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]

  @@map("users")
}

// Server-side record of every refresh token issued (only a SHA-256 hash is stored).
// /auth/refresh revokes the presented token and issues a new one in the same family;
// presenting a revoked token again revokes the whole family (see README).
model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique @map("token_hash")
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
