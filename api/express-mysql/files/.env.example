# Express API Configuration
# Copy this file to .env and update values

# =============================================================================
# DATABASE
# =============================================================================
# MySQL (local: start DB with `docker compose up -d` from project root; default host port 3307)
DATABASE_URL="mysql://gpp_api:gpp_api_dev@localhost:3307/myapp_db"

# =============================================================================
# SERVER
# =============================================================================
API_PORT=3001
NODE_ENV=development

# =============================================================================
# AUTHENTICATION
# =============================================================================
# IMPORTANT: Change this in production!
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_EXPIRES_IN="30d"

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins (used in production)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
