# Express API Configuration
# Copy this file to .env and update values

# =============================================================================
# DATABASE
# =============================================================================
# MySQL (local: start DB with `docker compose up -d` from project root; default host port 3308 to avoid clashing with cms-only MariaDB on 3307)
DATABASE_URL="mysql://gpp_api:gpp_api_dev@localhost:3308/{{PROJECT_DB_SNAKE}}_api_db"

# =============================================================================
# REDIS (optional)
# =============================================================================
# Empty or unset disables Redis (/health reports "redis": "disabled").
# REDIS_URL="redis://localhost:6379/0"

# =============================================================================
# SERVER
# =============================================================================
API_PORT=3001
NODE_ENV=development

# =============================================================================
# AUTHENTICATION
# =============================================================================
# With NODE_ENV=production the server refuses to start unless JWT_SECRET is set, is not
# a placeholder (nothing containing "change-me") and is at least 32 characters,
# e.g. `openssl rand -hex 32`.
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_EXPIRES_IN="30d"

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins (used in production)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
