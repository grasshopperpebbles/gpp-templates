{
  "name": "fastapi",
  "displayName": "FastAPI",
  "description": "Python FastAPI template with SQLAlchemy, Pydantic, Redis, JWT authentication, pytest setup, and a production Dockerfile.",
  "platform": "api",
  "dependencies": {
    "requires": [],
    "requiresVariant": null,
    "optional": []
  },
  "features": {
    "included": [
      "FastAPI with Python 3.12",
      "SQLAlchemy ORM (async)",
      "Pydantic models for validation",
      "Alembic migrations",
      "Comprehensive middleware stack",
      "CORS configuration",
      "Request logging",
      "Error handling",
      "JWT authentication support",
      "Health check endpoint",
      "OpenAPI/Swagger documentation",
