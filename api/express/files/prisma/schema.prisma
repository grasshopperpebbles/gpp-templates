// Prisma Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL (GPP's root docker-compose runs postgres:16 as <slug>-db)
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// "admin" may list/read/create users and change or delete other accounts (see README).
enum Role {
  user
  admin
}

// User model - basic authentication and profile
model User {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String?
  password      String?
  role          Role                 @default(user)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  tokenFamilies RefreshTokenFamily[]

  @@map("users")
}

// One row per login (token family). /auth/refresh locks this row for the whole rotation, and
// reuse detection sets revoked_at here as well as on the tokens, so a family revoked for reuse
// can never gain a live token (see src/lib/tokens.ts).
model RefreshTokenFamily {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  revokedAt DateTime?      @map("revoked_at")
  rotations Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens    RefreshToken[]

  @@index([userId])
  @@map("refresh_token_families")
}

// Server-side record of every refresh token issued (only a SHA-256 hash is stored).
// /auth/refresh revokes the presented token and issues a new one in the same family;
// presenting a revoked token again revokes the whole family (see README).
model RefreshToken {
  id           String             @id @default(cuid())
  tokenHash    String             @unique @map("token_hash")
  userId       String             @map("user_id")
  familyId     String             @map("family_id")
  expiresAt    DateTime           @map("expires_at")
  revokedAt    DateTime?          @map("revoked_at")
  replacedById String?            @map("replaced_by_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  family       RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
