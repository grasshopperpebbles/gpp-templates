# Express API Configuration
# Copy this file to .env and update values

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL (prisma/schema.prisma uses provider "postgresql")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/{{PROJECT_DB_SNAKE}}_api"

# =============================================================================
# REDIS (optional)
# =============================================================================
# Empty or unset disables Redis (/health reports "redis": "disabled").
# REDIS_URL="redis://localhost:6379/0"

# =============================================================================
# SERVER
# =============================================================================
API_PORT=3001
NODE_ENV=development

# =============================================================================
# AUTHENTICATION
# =============================================================================
# With NODE_ENV=production the server refuses to start unless JWT_SECRET is set, is not
# a placeholder (nothing containing "change-me") and is at least 32 characters,
# e.g. `openssl rand -hex 32`.
JWT_SECRET="change-me-in-production-use-a-long-random-string"
# Access tokens are stateless (valid until they expire). Refresh tokens are stored as
# hashes in the refresh_tokens table, rotated on every /auth/refresh and revoked by
# /auth/logout.
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_EXPIRES_IN="30d"

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins (used in production)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
