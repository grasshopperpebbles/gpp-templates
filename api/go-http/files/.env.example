# Server configuration
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s

# Comma-separated allowed browser origins; empty allows any origin
CORS_ORIGINS=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# gpp appends the database and Redis connection strings below. In Docker, the
# root docker-compose.yml overrides them with the container hostnames.
