# Server configuration
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s

# Comma-separated allowed browser origins; empty allows any origin
CORS_ORIGINS=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Postgres: each database call is cut off after this long (Go duration).
DATABASE_QUERY_TIMEOUT=5s

# gpp appends the database and Redis connection strings below. In Docker, the
# root docker-compose.yml overrides them with the container hostnames.
# With a database connection string set, items live in Postgres (the schema is
# created on startup); without one they are kept in memory and lost on restart.
