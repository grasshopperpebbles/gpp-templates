      "Basic Next.js structure",
      "Home page",
      "About page",
      "Privacy policy page",
      "Terms of service page",
      "Contact page",
      "Site header with navigation",
      "Site footer with links",
      "Pagefind static search",
      "Optional API client",
      "Optional WordPress client",
      "TypeScript support",
      "Tailwind CSS",
      "Responsive design"
    ],
    "excluded": [
      "Authentication (optional)",
      "CMS integration (optional)",
      "E-commerce functionality",
      "Dashboard features",
      "Admin features"
    ]
  },
  "homepageType": "generic",
  "routes": {
    "shared": [
      "/",
      "/about",
      "/contact",
      "/privacy",
      "/terms"
    ]
