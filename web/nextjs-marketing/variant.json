{
  "name": "marketing",
  "displayName": "Marketing Site",
  "description": "Multi-page marketing site template with standard pages (about, privacy, terms, contact). Ideal for company websites, portfolios, and content-focused sites.",
  "platform": "web",
  "dependencies": {
    "requires": [],
    "requiresVariant": null,
    "optional": ["api", "cms"]
  },
  "features": {
