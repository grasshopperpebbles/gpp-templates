{
  "name": "saas-dashboard",
  "displayName": "SaaS Dashboard",
  "description": "Next.js dashboard template for SaaS applications. Auth, data tables, settings included by default. Team management and billing available via feature flags.",
  "platform": "web",
  "isDefault": false,
  "dependencies": {
    "requires": ["api"],
    "requiresVariant": null,
    "optional": ["worker"]
  },
  "features": {
    "included": [
      "Authentication (NextAuth credentials session)",
      "Server-protected routes",
      "Dashboard with stats cards",
      "Data tables (sortable, filterable, paginated)",
      "User settings and profile",
      "API integration (Express/FastAPI)",
      "Dark mode",
      "Responsive sidebar layout",
      "React Query data fetching",
      "Toast notifications"
    ],
    "optIn": [
      "Team management (NEXT_PUBLIC_ENABLE_TEAMS)",
      "Billing management (NEXT_PUBLIC_ENABLE_BILLING)"
    ],
    "excluded": [
      "CMS integration",
      "WordPress backend",
      "E-commerce functionality",
      "Content management"
    ]
  },
  "homepageType": "dashboard",
  "routes": {
    "api": ["/api/auth", "/api/dashboard", "/api/health"],
    "shared": ["/dashboard", "/settings", "/profile", "/login", "/register"],
    "optIn": ["/admin/team", "/admin/billing"]
  }
}
