      "Checkout process",
      "Payment processing",
      "Order management",
      "Customer accounts",
      "E-commerce integration"
    ]
  },
  "homepageType": "blog",
  "routes": {
    "cms": ["/blog", "/article", "/articles"],
    "shared": ["/about", "/contact", "/privacy", "/terms"]
  }
